# ── 대본·장면 LLM (STEP 02~03) ── openai(기본) | exaone
LLM_PROVIDER=openai
EXAONE_API_KEY=
EXAONE_MODEL=k-exaone_v2.5
# low | high | max  (high 이상은 대본 1건에 3분 이상 걸릴 수 있음)
EXAONE_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── 화이트보드 이미지 (STEP 04) ── openai | placeholder(개발·스모크 테스트 전용)
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high
OPENAI_IMAGE_QUALITY=medium
STYLE_PRESET=marker_mono

# ── TTS (STEP 05) ── edge | elevenlabs
TTS_PROVIDER=edge
EDGE_VOICE=ko-KR-SunHiNeural
EDGE_RATE=+8%
ELEVENLABS_API_KEY=
# 무료 플랜은 Voice Library(공유) 목소리를 API 로 못 씀(402 paid_plan_required) → 기본(premade) 목소리 사용.
# 기본 목소리 21개 비교(eval/voice_bench_elevenlabs_premade.json) 결과 선정: Alice(교육자 톤, 6.5자/초, 받아쓰기 4회 100%)
# 예비: Brian nPczCjzI2devNBz1zQrb (남성, 6.92자/초, 100%)
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── 경로 ──
JOBS_DIR=./jobs

# ── 외부 공유(scripts/share.ps1) ── 비밀번호가 있으면 모든 화면·API 에 로그인 창을 띄운다
DEMO_USER=demo
DEMO_PASSWORD=
# 하루 새 작업(재생성 포함) 최대 수. 편당 약 $0.3 → 20편이면 하루 최대 약 $6
DEMO_MAX_JOBS_PER_DAY=20
